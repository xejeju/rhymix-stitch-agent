# 절대 커밋하지 마세요. 이 파일을 .env로 복사해서 실제 값을 채우세요.

FTP_USER=
FTP_PASSWORD=

# SSH(원격 DB에 SQL 실행용) 계정. 비워두면 FTP_USER/FTP_PASSWORD를 그대로 씁니다 —
# 카페24 같은 호스팅은 보통 FTP/SSH 계정이 동일합니다. 다르면 여기에 따로 채우세요.
SSH_USER=
SSH_PASSWORD=

# 원격 MySQL 접속 계정. 비워두면 위 SSH 계정을 그대로 씁니다.
MYSQL_USER=
MYSQL_PASSWORD=

STITCH_API_KEY=

# n8n은 보안상 워크플로 안에서 환경변수 접근을 막기 때문에, n8n-workflow.json의 HTTP
# 요청 노드들은 아래 주소를 고정값으로 직접 담고 있습니다. config.json의 bridgePort를
# 바꾸면 n8n-workflow.json 쪽 URL도 같이 수정해야 합니다. (참고용으로만 남겨둠)
BRIDGE_URL=http://127.0.0.1:3100
